# Static images: not fingerprinted, so a moderate TTL (30 days), not immutable.
# HTML, the manifest and /api/og (Worker, 1 h) keep their defaults.
/thumbs/*
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=2592000
/icon.svg
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/icon-maskable-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
